# Supply-chain hardening for npm
# Don't run package install scripts (postinstall is the #1 malware vector in npm).
# Re-enable per package only if needed: npm rebuild <pkg>
ignore-scripts=true
# `npm audit` exits non-zero only for high/critical advisories (CI gate threshold)
audit-level=high
# Record exact versions so the lockfile is the source of truth
save-exact=true
# Pin the registry so a stray scope config can't redirect installs (dependency confusion)
registry=https://registry.npmjs.org/
